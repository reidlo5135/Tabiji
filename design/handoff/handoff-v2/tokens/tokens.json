{
  "$schema": "tabiji-tokens-v2",
  "version": "2.0.0",
  "name": "Tabiji 旅路 v2 — 도감 같은 여행 수첩 · 테마 시스템",
  "units": { "size": "dp", "font": "sp", "duration": "ms" },
  "themeModel": {
    "note": "색은 '역할(role) × 테마(theme)' 2차원. 코드에서는 TabijiTheme.colors.<role> 하나만 쓰고, 사용자가 설정에서 theme 를 바꾸면 전체 팔레트가 교체된다. 기본 테마 = cloud.",
    "roles": {
      "paper":   "화면 배경 종이색 (+ stripe 로 45° 스트라이프)",
      "stripe":  "배경 스트라이프 (paper 보다 한 단계 진하게, 16dp 간격)",
      "ink":     "테두리·본문 글자·하드 섀도의 잉크색",
      "card":    "패널·카드 면",
      "soft":    "패널 안 리스트 바탕 (card 보다 한 단계 톤)",
      "accent":  "주요 버튼 채움 · 선택 테두리 · 도보 경로 · 선택 마커",
      "onAccent":"accent 채움 위 글자 (전 테마 #FFFFFF)",
      "sub":     "보조 글자",
      "h1h2h3":  "패널·카드 헤더 로테이션 색 (korea 만 h4 추가). 헤더 글자는 전 테마 #FFFFFF",
      "shadow":  "하드 오프셋 섀도 (ink 22%)",
      "skel":    "스켈레톤 블록",
      "est":     "'추정' 배지 채움 (글자 #2A1D08 고정)",
      "err":     "오류 테두리·아이콘 / errSoft: 오류 배너 배경",
      "ok":      "AI 제안 '이유' 체크 아이콘"
    }
  },
  "themes": {
    "cloud":  { "label": "기본 · 구름", "paper": "#F2F7FC", "stripe": "#E8F1F9", "ink": "#2A3644", "card": "#FFFFFF", "soft": "#EAF3FB", "accent": "#3E8FC7", "onAccent": "#FFFFFF", "sub": "#5B6878", "h1": "#4A8FC2", "h2": "#5F74B8", "h3": "#4A9A93", "shadow": "#2A364438", "skel": "#DEE6EE", "est": "#E3A23B", "err": "#C0463C", "errSoft": "#F7E3E0", "ok": "#2E7D5B" },
    "spring": { "label": "봄 · 벚꽃", "paper": "#FCF3F5", "stripe": "#F7E8EC", "ink": "#43313A", "card": "#FFFFFF", "soft": "#F9E9EE", "accent": "#C95E7E", "onAccent": "#FFFFFF", "sub": "#6E5A63", "h1": "#C95E7E", "h2": "#6F9148", "h3": "#9A77C2", "shadow": "#43313A38", "skel": "#EEDDE2", "est": "#E3A23B", "err": "#C0463C", "errSoft": "#F7E3E0", "ok": "#2E7D5B" },
    "summer": { "label": "여름 · 바다", "paper": "#EFF9FB", "stripe": "#E2F2F6", "ink": "#1E3B4C", "card": "#FFFFFF", "soft": "#E2F4F8", "accent": "#1F96B8", "onAccent": "#FFFFFF", "sub": "#4E6B7A", "h1": "#1F96B8", "h2": "#2C7FC9", "h3": "#2E9E85", "shadow": "#1E3B4C38", "skel": "#D8EBF1", "est": "#E3A23B", "err": "#C0463C", "errSoft": "#F7E3E0", "ok": "#2E7D5B" },
    "autumn": { "label": "가을 · 단풍", "paper": "#FBF3E6", "stripe": "#F4E8D3", "ink": "#46321F", "card": "#FFFDF8", "soft": "#F7EAD6", "accent": "#C06F22", "onAccent": "#FFFFFF", "sub": "#77614A", "h1": "#C06F22", "h2": "#8F741A", "h3": "#B35C3B", "shadow": "#46321F38", "skel": "#ECDFC8", "est": "#E3A23B", "err": "#C0463C", "errSoft": "#F7E3E0", "ok": "#2E7D5B" },
    "winter": { "label": "겨울 · 설원", "paper": "#F1F5FA", "stripe": "#E6EDF6", "ink": "#2A3650", "card": "#FFFFFF", "soft": "#E8EEF8", "accent": "#5674AE", "onAccent": "#FFFFFF", "sub": "#5B6880", "h1": "#5674AE", "h2": "#6676B8", "h3": "#7E6FB5", "shadow": "#2A365038", "skel": "#DCE4F0", "est": "#E3A23B", "err": "#C0463C", "errSoft": "#F7E3E0", "ok": "#2E7D5B" },
    "korea":  { "label": "한국 · 한지와 단청", "paper": "#FAF4EA", "stripe": "#F2E9DA", "ink": "#30261C", "card": "#FFFCF5", "soft": "#EDE4D2", "accent": "#2F5E9E", "onAccent": "#FFFFFF", "sub": "#6B5D4A", "h1": "#2F5E9E", "h2": "#BE4450", "h3": "#2E7D5B", "h4": "#A8801F", "shadow": "#30261C38", "skel": "#E8DFCF", "est": "#E3A23B", "err": "#C0463C", "errSoft": "#F7E3E0", "ok": "#2E7D5B" },
    "china":  { "label": "중국 · 주홍과 옥", "paper": "#FCF2EA", "stripe": "#F6E6D8", "ink": "#3C241C", "card": "#FFFAF3", "soft": "#F6E3D6", "accent": "#BE4435", "onAccent": "#FFFFFF", "sub": "#7A5A48", "h1": "#BE4435", "h2": "#A8791C", "h3": "#357F63", "shadow": "#3C241C38", "skel": "#EFDFD2", "est": "#E3A23B", "err": "#C0463C", "errSoft": "#F7E3E0", "ok": "#2E7D5B" },
    "japan":  { "label": "일본 · 아이(藍)와 와시", "paper": "#F6F5F0", "stripe": "#ECEAE2", "ink": "#2B2B30", "card": "#FFFEFA", "soft": "#E9E7DC", "accent": "#2B4C7E", "onAccent": "#FFFFFF", "sub": "#5F5F66", "h1": "#2B4C7E", "h2": "#C25548", "h3": "#5F7038", "shadow": "#2B2B3038", "skel": "#E2E0D6", "est": "#E3A23B", "err": "#C0463C", "errSoft": "#F7E3E0", "ok": "#2E7D5B" }
  },
  "routeColors": { "walk": "accent", "transit": "h2", "drive": "h3", "note": "경로·구간 칩 연결선은 역할 색을 그대로 참조. 도보는 점선(2 on 11 off, round cap), 나머지 실선. 미계산 45% 불투명" },
  "border": { "panel": 2, "chip": 1.5, "selected": 3, "divider": 2, "badgeInHeader": 2 },
  "shadowSpec": {
    "panel":  { "x": 3, "y": 3, "blur": 0, "color": "shadow", "note": "블러 0 솔리드 오프셋 — v2 의 핵심 질감" },
    "button": { "x": 0, "y": 3, "blur": 0, "color": "ink", "note": "주요·칩 버튼 하단. 눌림 = translateY(2dp) + y 1dp 로" },
    "modal":  { "x": 5, "y": 5, "blur": 0, "color": "#00000059" }
  },
  "stripeSpec": { "angle": 45, "width": 16, "gap": 16, "phoneWidth": 14, "note": "repeating-linear-gradient(45°, transparent 0 16, stripe 16 32)" },
  "radius": { "panel": 10, "row": 9, "chip": 999, "numBadge": 6, "button": 10, "buttonChamfer": 8, "sheetTop": 18, "input": 10 },
  "spacing": { "grid": 4, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "touchTarget": 48, "screenMarginPhone": 14, "screenMarginDesktop": 16, "panelDesktopWidth": 376, "headerStripDesktop": 52, "headerStripCard": 32, "headerStripPhone": 44 },
  "typography": {
    "fontFamily": { "display": "Jua", "body": "Pretendard JP", "numeric": "Sora", "note": "Jua 는 한글·라틴만 — 한자·가나가 섞이는 줄은 Pretendard JP 로. 디스플레이 = 제목·버튼 라벨·Day N·카드 헤더·탭·필터 칩" },
    "displayXL": { "size": 26, "lineHeight": 32, "family": "Jua", "use": "화면 제목 (내 여행)" },
    "displayL":  { "size": 20, "lineHeight": 26, "family": "Jua", "use": "패널 헤더 (Day 2), 모달 제목" },
    "displayM":  { "size": 16, "lineHeight": 22, "family": "Jua", "use": "카드 헤더, 버튼 라벨, 필터 칩" },
    "displayS":  { "size": 14, "lineHeight": 18, "family": "Jua", "use": "작은 카드 헤더, 탭" },
    "body":      { "size": 14, "lineHeight": 20, "weight": 600, "family": "Pretendard JP", "use": "방문지 정보 주 텍스트 (v2 는 기본 600)" },
    "caption":   { "size": 12, "lineHeight": 16, "weight": 600, "family": "Pretendard JP" },
    "badge":     { "size": 11, "lineHeight": 14, "weight": 700, "family": "Pretendard JP" },
    "numeric":   { "size": 12, "lineHeight": 16, "weight": 600, "family": "Sora", "use": "날짜·거리·시간" },
    "wordmark":  { "family": "Sora", "weight": 700, "note": "로고는 v1 그대로 Sora. 인트로에서는 흰 글자 + 잉크 아웃라인(stroke 2dp 상당) + 하드 섀도" }
  },
  "motion": {
    "micro":      { "duration": 120, "easing": [0.2, 0, 0, 1], "use": "호버·체크·칩" },
    "press":      { "duration": 80,  "easing": [0.2, 0, 0, 1], "use": "버튼 눌림: translateY 2dp + 하단 섀도 3→1dp. 스프링·바운스 금지" },
    "transition": { "duration": 240, "easing": [0.2, 0, 0, 1], "use": "시트 단계·패널 접기·선택·테마 전환 크로스페이드" },
    "themeSwitch":{ "duration": 240, "note": "테마 변경 시 색만 크로스페이드 — 레이아웃 애니메이션 없음" },
    "camera":     { "duration": 600, "easing": [0.4, 0, 0.2, 1] },
    "intro":      { "quadrantFadeStagger": 150, "logoRise": 600, "note": "v1 타이밍 유지 (10_intro.md)" }
  },
  "opacity": { "disabled": 0.5, "struck": 0.55, "routeUncomputed": 0.45 }
}
