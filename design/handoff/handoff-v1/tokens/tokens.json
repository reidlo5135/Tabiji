{
  "$schema": "tabiji-tokens-v1",
  "version": "1.0.0",
  "name": "Tabiji 旅路 — 맑은 하늘 위의 실버 테크",
  "units": { "size": "dp", "font": "sp", "duration": "ms" },
  "color": {
    "bg.sky.top":          { "light": "#EAF3FB", "dark": "#0E1621", "kotlin": "bgSkyTop",          "use": "배경 그라데이션 위" },
    "bg.sky.bottom":       { "light": "#F7F9FC", "dark": "#18212D", "kotlin": "bgSkyBottom",       "use": "배경 그라데이션 아래" },
    "surface.glass":       { "light": "#FFFFFFB8", "dark": "#1E2733B8", "kotlin": "surfaceGlass",  "use": "지도 위 패널 (72%). 블러 16dp와 함께" },
    "surface.glass.solid": { "light": "#FFFFFFEB", "dark": "#1E2733EB", "kotlin": "surfaceGlassSolid", "use": "블러 불가 시 대체 표면 (92%)" },
    "surface.card":        { "light": "#FFFFFFD1", "dark": "#1E2733D1", "kotlin": "surfaceCard",   "use": "패널 안 카드 (82%)" },
    "surface.chip":        { "light": "#FFFFFFE6", "dark": "#242E3CE6", "kotlin": "surfaceChip",   "use": "구간 칩 (90%)" },
    "surface.silver.from": { "light": "#F4F6F9", "dark": "#2A3441", "kotlin": "surfaceSilverFrom", "use": "실버 그라데이션 시작 (위)" },
    "surface.silver.to":   { "light": "#C9D1DB", "dark": "#3A4655", "kotlin": "surfaceSilverTo",   "use": "실버 그라데이션 끝 (아래)" },
    "surface.silver.pressed.from": { "light": "#DDE3EA", "dark": "#222B36", "kotlin": "surfaceSilverPressedFrom", "use": "실버 버튼 눌림" },
    "surface.silver.pressed.to":   { "light": "#B9C3CF", "dark": "#2F3947", "kotlin": "surfaceSilverPressedTo",   "use": "실버 버튼 눌림" },
    "surface.skeleton":    { "light": "#E6EBF1", "dark": "#2A3441", "kotlin": "surfaceSkeleton",   "use": "스켈레톤 블록" },
    "surface.skeleton.hi": { "light": "#F3F6F9", "dark": "#354253", "kotlin": "surfaceSkeletonHi", "use": "스켈레톤 시머 하이라이트" },
    "surface.scrim":       { "light": "#1C263352", "dark": "#00000080", "kotlin": "surfaceScrim",  "use": "모달 뒤 스크림 (32% / 50%)" },
    "line.highlight":      { "light": "#FFFFFFCC", "dark": "#FFFFFF24", "kotlin": "lineHighlight", "use": "패널·버튼 상단 1dp 하이라이트 (80% / 14%)" },
    "line.subtle":         { "light": "#D5DCE4", "dark": "#334051", "kotlin": "lineSubtle",        "use": "구분선·테두리 1dp" },
    "text.primary":        { "light": "#1C2633", "dark": "#E9EEF4", "kotlin": "textPrimary",       "use": "본문" },
    "text.secondary":      { "light": "#5B6878", "dark": "#9AA7B6", "kotlin": "textSecondary",     "use": "보조 (흰 배경 5.7:1)" },
    "accent.sky":          { "light": "#2FA8E0", "dark": "#5CC3F0", "kotlin": "accentSky",         "use": "주요 버튼 채움, 선택 테두리, 도보 경로, 마커 선택" },
    "accent.pressed":      { "light": "#1F8FC4", "dark": "#45B2E3", "kotlin": "accentPressed",     "use": "주요 버튼 눌림" },
    "accent.text":         { "light": "#1A78A8", "dark": "#5CC3F0", "kotlin": "accentText",        "use": "밝은 표면 위 accent 색 글자·아이콘 (4.9:1). 신설" },
    "accent.on":           { "light": "#0E1621", "dark": "#0E1621", "kotlin": "onAccent",          "use": "accent 채움 위 글자 (6.8:1). 신설 — 흰 글자는 2.7:1로 미달" },
    "accent.line":         { "light": "#1A8FC6", "dark": "#5CC3F0", "kotlin": "accentLine",        "use": "선·테두리용 accent: 선택 카드 테두리 2dp, 포커스 테두리, 도보 경로선, 선택 필터 칩 테두리 (밝은 표면 위 3.3:1 이상). 신설" },
    "accent.soft":         { "light": "#2FA8E024", "dark": "#5CC3F02E", "kotlin": "accentSoft",    "use": "선택 링 4dp, 선택 필터 칩 배경 (14% / 18%)" },
    "route.walk":          { "light": "#1A8FC6", "dark": "#5CC3F0", "kotlin": "routeWalk",         "use": "도보 경로 = accent.line, 점선 2 on 9 off (지도 땅 위 3.3:1)" },
    "route.transit":       { "light": "#6C7BE0", "dark": "#8E9AF0", "kotlin": "routeTransit",      "use": "대중교통 경로 실선 (다크값 제안)" },
    "route.drive":         { "light": "#3A9A74", "dark": "#6FC9A6", "kotlin": "routeDrive",        "use": "자동차 경로 실선. 라이트는 시작값 #4FB08A(2.4:1)에서 3:1을 넘기도록 조정, 다크값 제안" },
    "status.estimated":    { "light": "#E3A23B", "dark": "#F0B862", "kotlin": "statusEstimated",   "use": "\"추정\" 배지 채움 전용. 글자색으로 쓰지 않음 (흰 배경 2.2:1)" },
    "status.error":        { "light": "#D9534F", "dark": "#F07A76", "kotlin": "statusError",       "use": "오류 테두리·아이콘 (그래픽 3:1). 글자에는 쓰지 않음" },
    "status.error.text":   { "light": "#B23A36", "dark": "#F6A09D", "kotlin": "statusErrorText",   "use": "오류 메시지 글자 (입력 필드 아래 12sp). 신설" },
    "status.error.soft":   { "light": "#D9534F1F", "dark": "#F07A7629", "kotlin": "statusErrorSoft", "use": "오류 배너 배경 (12% / 16%)" },
    "marker.stroke":       { "light": "#AEB8C4", "dark": "#AEB8C4", "kotlin": "markerStroke",      "use": "지도 마커 테두리 1dp (지도 위라 테마 무관)" },
    "marker.face":         { "light": "#FFFFFF", "dark": "#FFFFFF", "kotlin": "markerFace",        "use": "마커 안 흰 원" }
  },
  "gradient": {
    "sky":    { "direction": "vertical", "stops": ["bg.sky.top", "bg.sky.bottom"] },
    "silver": { "direction": "vertical", "stops": ["surface.silver.from", "surface.silver.to"], "note": "한 겹만. 위에 line.highlight 1dp" }
  },
  "shadow": {
    "panel": { "light": { "offsetY": 8,  "blur": 24, "color": "#1C26331A" }, "dark": { "offsetY": 8,  "blur": 24, "color": "#00000059" }, "kotlin": "shadowPanel" },
    "lift":  { "light": { "offsetY": 14, "blur": 32, "color": "#1C263329" }, "dark": { "offsetY": 14, "blur": 32, "color": "#00000073" }, "kotlin": "shadowLift", "use": "드래그 중 카드, 로고 패널" },
    "markerSelected": { "light": { "offsetY": 6, "blur": 10, "color": "#2FA8E073" }, "dark": { "offsetY": 6, "blur": 10, "color": "#5CC3F073" } }
  },
  "blur": { "panel": 16, "sheet": 20, "modal": 24, "fallback": "surface.glass.solid" },
  "spacing": { "grid": 4, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "touchTarget": 48, "screenMarginPhone": 16, "screenMarginDesktop": 24 },
  "radius": { "card": 12, "panel": 16, "sheet": 20, "chip": 999, "button": 12, "buttonChamfer": 8, "logoFrame": 14, "logoFrameChamfer": 12, "input": 12 },
  "size": {
    "panelDesktopWidth": 360, "panelDesktopCollapsed": 56, "searchFieldDesktopWidth": 360,
    "bottomSheetCollapsed": 96, "bottomSheetHalf": 420, "bottomSheetHandle": [36, 4],
    "glassCircleButton": 48, "primaryButtonHeight": 48, "secondaryButtonHeight": 44, "inputHeight": 48,
    "visitCardNumber": 28, "segmentChipHeight": 28, "segmentConnector": 2, "dayHeaderExpanded": 72, "dayHeaderCollapsed": 56,
    "marker": [32, 40], "markerSelected": [40, 50], "markerFixedBadge": 14, "routeStroke": 4,
    "icon": 24, "iconSmall": 20, "iconChip": 16, "iconStroke": 1.75
  },
  "typography": {
    "fontFamily": { "body": "Pretendard JP", "display": "Sora", "numeric": "Sora" },
    "display":  { "size": 40, "lineHeight": 48, "weight": 700, "letterSpacing": -0.02, "family": "display" },
    "title":    { "size": 22, "lineHeight": 28, "weight": 600, "letterSpacing": -0.01, "family": "display|body", "note": "Day N·숫자는 Sora, 한글 제목은 Pretendard" },
    "subtitle": { "size": 16, "lineHeight": 22, "weight": 600, "letterSpacing": 0, "family": "body" },
    "body":     { "size": 14, "lineHeight": 20, "weight": 400, "letterSpacing": 0, "family": "body", "strongWeight": 600 },
    "caption":  { "size": 12, "lineHeight": 16, "weight": 400, "letterSpacing": 0, "family": "body", "strongWeight": 600 },
    "numeric":  { "size": 12, "lineHeight": 16, "weight": 600, "letterSpacing": 0, "family": "numeric", "note": "날짜·거리·시간 숫자" },
    "badge":    { "size": 11, "lineHeight": 14, "weight": 600, "letterSpacing": 0, "family": "body" }
  },
  "motion": {
    "micro":      { "duration": 120, "easing": [0.2, 0, 0, 1],   "use": "눌림·호버·체크" },
    "transition": { "duration": 240, "easing": [0.2, 0, 0, 1],   "use": "시트 단계, 패널 접기, 마커 선택, 카드 선택" },
    "camera":     { "duration": 600, "easing": [0.4, 0, 0.2, 1], "use": "지도 flyTo" },
    "introQuadrantFade": { "duration": 300, "stagger": 150, "easing": [0.2, 0, 0, 1] },
    "introLogoRise":     { "duration": 600, "delay": 600, "offsetDp": 12, "easing": [0.2, 0, 0, 1] },
    "introHighlightSweep": { "duration": 400, "delay": 800 },
    "ambient": { "particleFall": [9000, 12000], "snowFall": [11000, 15000], "cloudDrift": [14000, 18000], "glint": [2000, 3000], "shimmer": 1200 },
    "rule": "바운스·오버슈트 금지. 감속(decelerate)만. 동작 줄이기 시 ambient·intro 전환 0ms"
  },
  "opacity": { "disabled": 0.5, "dragging": 0.96, "routeUncomputed": 0.45, "introNightOverlay": 0.55 }
}
